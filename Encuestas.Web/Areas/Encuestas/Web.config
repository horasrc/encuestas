<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración que el módulo de encuestas necesita para sus propios archivos estáticos
  (Areas/Encuestas/Content y Scripts). Se copia junto con el Área; no hay que tocar el
  Web.config del portal por esto.
-->
<configuration>
  <system.webServer>
    <!-- Fuentes de Bootstrap Icons: IIS antiguos no conocen estos tipos y responderían 404. -->
    <staticContent>
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>
</configuration>
