@model SurveyPageViewModel
@{
    ViewBag.Title = "Constructor de encuestas";
}
@* ------------------------------------------------------------------
   Pantalla principal del módulo. Cada parcial es una sección
   independiente; el contenido dinámico lo dibuja Scripts/survey/*.js.
   Los comentarios "demo:*" los usa tools/build-demo.ps1 para generar
   demo.html (versión estática para revisar sin IIS).
   ------------------------------------------------------------------ *@
@* demo:body *@
<div class="sv-page" id="surveyPage" aria-busy="true">
    @Html.Partial("_BuilderHeader")

    <div class="tab-content">
        @Html.Partial("_TabConstructor")
        @Html.Partial("_TabSettings")
        @Html.Partial("_TabPreview")
        @Html.Partial("_TabResults")
    </div>
</div>

@Html.Partial("_Modals")
@* demo:end-body *@

@section scripts {
    @* demo:scripts *@
    @Html.Partial("_SurveyConfig", Model)
    @Html.Partial("_SurveyScripts")
    <script src="@Url.Versioned("~/Areas/Encuestas/Scripts/survey-builder.js")"></script>
    <script src="@Url.Versioned("~/Areas/Encuestas/Scripts/survey-editor.js")"></script>
    <script src="@Url.Versioned("~/Areas/Encuestas/Scripts/survey-settings.js")"></script>
    <script src="@Url.Versioned("~/Areas/Encuestas/Scripts/survey-preview.js")"></script>
    <script src="@Url.Versioned("~/Areas/Encuestas/Scripts/survey-results.js")"></script>
    <script src="@Url.Versioned("~/Areas/Encuestas/Scripts/survey-app.js")"></script>
    @* demo:end-scripts *@
}
