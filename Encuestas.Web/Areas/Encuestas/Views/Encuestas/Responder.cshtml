@model SurveyPageViewModel
@{
    // Página independiente del menú del portal: el colaborador solo ve la encuesta.
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Encuesta · Portal interno</title>
    <link href="@Url.Versioned("~/Areas/Encuestas/Content/lib/bootstrap-5.2.3/css/bootstrap.min.css")" rel="stylesheet" />
    <link href="@Url.Versioned("~/Areas/Encuestas/Content/lib/bootstrap-icons-1.11.3/bootstrap-icons.min.css")" rel="stylesheet" />
    <link href="@Url.Versioned("~/Areas/Encuestas/Content/survey.css")" rel="stylesheet" />
</head>
<body class="sv-respondent-body">
    @* demo:body *@
    @if (Model.Embedded)
    {
        @* Dentro del portal: regreso a la lista (pendientes, o el listado si administra). *@
        <div class="container sv-respond-container pt-3">
            <a class="btn btn-sm btn-light border" href="@Url.Action(Model.CanAdminister ? "Index" : "Pendientes", "Encuestas", new { area = "Encuestas", segmento = Model.Segment, embed = true })"><i class="bi bi-arrow-left me-1"></i>Volver</a>
        </div>
    }
    <div id="surveyRoot" class="container sv-respond-container" aria-live="polite">
        <div class="text-center py-5"><div class="spinner-border text-secondary" role="status"><span class="visually-hidden">Cargando…</span></div></div>
    </div>
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>
    @* demo:end-body *@

    <script src="@Url.Versioned("~/Areas/Encuestas/Content/lib/jquery-3.7.1/jquery.min.js")"></script>
    <script src="@Url.Versioned("~/Areas/Encuestas/Content/lib/bootstrap-5.2.3/js/bootstrap.bundle.min.js")"></script>
    @* demo:scripts *@
    @Html.Partial("_SurveyConfig", Model)
    @Html.Partial("_SurveyScripts")
    <script src="@Url.Versioned("~/Areas/Encuestas/Scripts/survey-respond.js")"></script>
    @* demo:end-scripts *@
</body>
</html>
