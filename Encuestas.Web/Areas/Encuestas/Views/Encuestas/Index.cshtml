@model SurveyPageViewModel
@{
    ViewBag.Title = "Encuestas";
}
@* Listado de encuestas + creación. El contenido lo dibuja Scripts/survey/survey-list.js. *@
@* demo:body *@
@Html.Partial("_ModuleStyles")
<div class="sv-page" id="surveyListPage">
    <header class="sv-page-header pb-3">
        <div class="sv-header-row">
            <div>
                <h1 class="h4 fw-bold mb-1">Encuestas</h1>
                <p class="text-muted small mb-0">Crea encuestas, publícalas para tu audiencia y consulta sus resultados.</p>
            </div>
            <button type="button" class="btn btn-accent" data-bs-toggle="modal" data-bs-target="#newSurveyModal">
                <i class="bi bi-plus-lg"></i> Nueva encuesta
            </button>
        </div>

        <div class="sv-list-toolbar">
            <ul class="nav sv-tabs sv-status-filter" id="statusFilter" role="tablist" aria-label="Filtrar por estado">
                <li class="nav-item"><button type="button" class="nav-link active" data-status="">Todas <span class="badge sv-count" data-count=""></span></button></li>
                <li class="nav-item"><button type="button" class="nav-link" data-status="Draft">Borrador <span class="badge sv-count" data-count="Draft"></span></button></li>
                <li class="nav-item"><button type="button" class="nav-link" data-status="Published">Publicadas <span class="badge sv-count" data-count="Published"></span></button></li>
                <li class="nav-item"><button type="button" class="nav-link" data-status="Closed">Cerradas <span class="badge sv-count" data-count="Closed"></span></button></li>
                <li class="nav-item"><button type="button" class="nav-link" data-status="Archived">Archivadas <span class="badge sv-count" data-count="Archived"></span></button></li>
            </ul>
            <div class="input-group input-group-sm sv-list-search">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="search" id="surveySearch" class="form-control" placeholder="Buscar encuesta…" aria-label="Buscar encuesta" />
            </div>
        </div>
    </header>

    <div class="card sv-card">
        <div class="table-responsive">
            <table class="table sv-list-table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Encuesta</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="d-none d-md-table-cell">Versión</th>
                        <th scope="col" class="text-end">Respuestas</th>
                        <th scope="col" class="d-none d-lg-table-cell">Vigencia</th>
                        <th scope="col"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody id="surveyListBody">
                    <tr><td colspan="6" class="text-center py-5"><div class="spinner-border text-secondary" role="status"><span class="visually-hidden">Cargando…</span></div></td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Nueva encuesta -->
<div class="modal fade" id="newSurveyModal" tabindex="-1" aria-labelledby="newSurveyTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="newSurveyForm" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="newSurveyTitle"><i class="bi bi-clipboard2-plus me-2"></i>Nueva encuesta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="newSurveyName" class="form-label">Nombre</label>
                    <input type="text" id="newSurveyName" class="form-control" maxlength="200" required placeholder="Ej. Experiencia con campañas comerciales" autocomplete="off" />
                    <div class="invalid-feedback">Escribe el nombre de la encuesta.</div>
                </div>
                <div>
                    <label for="newSurveyDescription" class="form-label">Descripción <span class="text-muted fw-normal">(opcional)</span></label>
                    <textarea id="newSurveyDescription" class="form-control" rows="2" maxlength="1000" placeholder="Para qué sirve y a quién va dirigida"></textarea>
                </div>
                <p class="small text-muted mt-3 mb-0"><i class="bi bi-info-circle me-1"></i>Se crea como borrador (versión 1). Después agregas las preguntas en el constructor.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-accent" id="btnCreateSurvey"><i class="bi bi-arrow-right me-1"></i> Crear y abrir constructor</button>
            </div>
        </form>
    </div>
</div>

@Html.Partial("_ConfirmModal")
@* demo:end-body *@

@section scripts {
    @* demo:scripts *@
    @Html.Partial("_ModuleScripts")
    @Html.Partial("_SurveyConfig", Model)
    @Html.Partial("_SurveyScripts")
    <script src="@Url.Versioned("~/Areas/Encuestas/Scripts/survey-list.js")"></script>
    @* demo:end-scripts *@
}
