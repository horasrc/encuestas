<?xml version="1.0" encoding="utf-8"?>
<!--
  Transformación para producción (se aplica al publicar en configuración Release).
  Los marcadores __SQL_SERVER__, __DATABASE__ y __ADMIN_ROLES__ los reemplaza
  tools\publish.ps1 con los parámetros que le indiques. Si publicas desde Visual
  Studio, edita el Web.config publicado y reemplázalos a mano.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="Surveys:UseMockData" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Surveys:Repository" value="Sql" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Surveys:CatalogProvider" value="Sql" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <!-- Nunca vacío en producción: vacío = cualquier usuario autenticado administra encuestas. -->
    <add key="Surveys:AdminRoles" value="__ADMIN_ROLES__" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>

  <connectionStrings>
    <add name="SurveysDb"
         connectionString="Data Source=__SQL_SERVER__;Initial Catalog=__DATABASE__;Integrated Security=True;Application Name=PortalEncuestas"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>

  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="RemoteOnly" xdt:Transform="SetAttributes" />
  </system.web>
</configuration>
