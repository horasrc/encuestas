<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <!--
      true  = el front-end usa datos mock (Scripts/survey/mock-data.js) + localStorage.
      false = el front-end llama a SurveyApiController (/SurveyApi/*).
    -->
    <add key="Surveys:UseMockData" value="false" />
    <!--
      Repositorio del servidor (solo aplica con UseMockData = false):
      Sql      = SqlSurveyRepository sobre la cadena de conexión "SurveysDb".
      InMemory = datos en memoria (se pierden al reiniciar).
    -->
    <add key="Surveys:Repository" value="Sql" />
    <!--
      Quién administra encuestas (constructor, resultados, API de edición).
      Roles/grupos de Windows separados por coma, ej. "DOMINIO\Encuestas-Admin".
      Vacío = cualquier usuario autenticado (solo recomendable en desarrollo).
    -->
    <add key="Surveys:AdminRoles" value="" />
    <!--
      true = rechaza respuestas de usuarios fuera de la segmentación. Requiere que el
      IOrgCatalogProvider devuelva los usuarios con su Login de red (DOMINIO\usuario).
    -->
    <add key="Surveys:EnforceAudience" value="false" />
    <!--
      Catálogos de segmentación (roles, segmentos, regiones, sucursales, usuarios):
      Sql  = tablas Org* (Database/org-schema.sql), en caché CatalogCacheMinutes minutos.
      Demo = catálogos de ejemplo en código.
    -->
    <add key="Surveys:CatalogProvider" value="Sql" />
    <add key="Surveys:CatalogCacheMinutes" value="10" />
  </appSettings>
  <connectionStrings>
    <!-- Cadena de conexión para el repositorio SQL (ver Database/schema.sql). -->
    <!-- Desarrollo: LocalDB (creada con tools\setup-db.ps1). En producción, apuntar al servidor SQL corporativo. -->
    <add name="SurveysDb" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=PortalEncuestas;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" maxRequestLength="4096" />
    <!-- fileEncoding: las vistas se leen como UTF-8 aunque no tengan BOM (evita acentos rotos). -->
    <globalization culture="es-MX" uiCulture="es-MX" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <!-- Portal interno: autenticación integrada de Windows. Ajustar según el portal corporativo. -->
    <authentication mode="Windows" />
    <!--
      Todas las peticiones deben llegar identificadas. Con Windows Authentication la identidad
      es por conexión: si se permitiera el acceso anónimo, algunos POST llegarían sin usuario y
      el token antifalsificación (ligado al usuario) fallaría con "La página expiró".
      "Encuesta anónima" en el módulo significa que los resultados no muestran quién respondió.
    -->
    <authorization>
      <deny users="?" />
    </authorization>
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-5.2.3.0" newVersion="5.2.3.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="false" />
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
</configuration>
